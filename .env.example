# ShipOverseas Node app
HOST=127.0.0.1
PORT=4173
SHIPOVERSEAS_DATA_DIR=shipoverseas/data

# Optional real email delivery through Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=ShipOverseas <updates@yourdomain.com>

# Legacy Next/Firebase app placeholders for the future Firebase migration
# This app uses Firebase app name "sea-cargo-tracker-web" and collection "shipments".
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
